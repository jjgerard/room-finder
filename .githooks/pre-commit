#!/bin/sh
# Keep docs/ in step with the model.
#
# docs/data/timetable.json is generated from the model and the current
# solution, and CI fails if the committed copy is not what export.js produces.
# Solving into docs/data runs the export itself, but changing the model or the
# data without re-solving does not — and that is the case that kept slipping
# through. So the export runs here, and anything it changes joins the commit.
#
# Enable with:  git config core.hooksPath .githooks
set -e
node timetable/export.js >/dev/null
if ! git diff --quiet -- docs/; then
  echo "pre-commit: docs/ regenerated by export.js, adding it to this commit"
  git add docs/
fi
