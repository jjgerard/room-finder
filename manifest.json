{
  "manifest_version": 3,
  "name": "Ulster Room Finder",
  "version": "0.2.0",
  "description": "Ask in plain words which rooms are free in a recurring slot in Ulster's Resource Booker, and see what would open it up.",
  "content_scripts": [
    {
      "matches": [
        "*://*/app/booking-types/*"
      ],
      "js": [
        "parse.js",
        "analyse.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ulster-room-finder@jjgerard.github.io",
      "strict_min_version": "128.0"
    }
  }
}
